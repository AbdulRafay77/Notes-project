<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>

    <main>
        <div class="container">
            <a href="/notes" class="back-link">&larr; Back to Notes</a>

            <div class="page-header">
                <h2>Create a Note</h2>
            </div>

            <div class="form-card">
                <form action="/notes" method="POST">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" name="title" id="title" placeholder="Give your note a title" required>
                    </div>

                    <div class="form-group">
                        <label for="content">Content</label>
                        <textarea name="content" id="content" rows="6" placeholder="Write your note here..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="category">Category</label>
                        <select name="category" id="category">
                            <option value="general">General</option>
                            <option value="personal">Personal</option>
                            <option value="work">Work</option>
                            <option value="study">Study</option>
                        </select>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-amber">Save Note</button>
                        <a href="/notes" class="btn btn-outline">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>
